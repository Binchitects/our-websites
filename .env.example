# Copy to .env and change what matters. Compose reads .env automatically.
#
# The two names Traefik routes. The certificate below must cover both.
ARGUS_DOMAIN=argus.binchitects.com
BINCHIECTS_DOMAIN=binchitects.com

# One certificate and key, shared by both names (SANs). Relative paths are
# resolved from this directory; absolute paths work too. See deploy/tls/.
TLS_CERT_FILE=./deploy/tls/fullchain.pem
TLS_KEY_FILE=./deploy/tls/privkey.pem

# The public edge. 80 and 443 in production; 9080/9443 for a local trial.
HTTP_PORT=80
HTTPS_PORT=443

# Docker socket for Traefik's provider. Rootless Docker:
# /run/user/1000/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# A random string; it makes the stored hash of an address useless anywhere else.
# Leave empty and the hash is of the address alone.
IP_HASH_SALT=

# Optional: enables GET /api/admin/leads (CSV) with the X-Admin-Token header.
ADMIN_TOKEN=

# Optional: a Slack/Teams/CRM webhook that receives each contact request as JSON.
CONTACT_WEBHOOK_URL=

# Optional: lifts GitHub's anonymous rate limit for the changelog.
GITHUB_TOKEN=

# Contact-form rate limit: requests per window, and the window in minutes.
CONTACT_PERMIT_LIMIT=5
CONTACT_WINDOW_MINUTES=10

# Image tag to build or pull.
IMAGE_TAG=local
