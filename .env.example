# Copy to .env and change what matters. Compose reads .env automatically.
#
# The addresses this stack answers for. Caddy uses them to get certificates.
SITE_DOMAIN=argus.binchitects.com
BINCHIECTS_DOMAIN=binchitects.com

# The published web ports. Loopback by default: put a TLS terminator in front
# (docker-compose.prod.yml brings Caddy), or set the BIND values to 0.0.0.0 for
# a trusted network while you test.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
BINCHIECTS_HTTP_BIND=127.0.0.1
BINCHIECTS_HTTP_PORT=8100

# A random string; it makes the stored hash of an address useless anywhere else.
# Leave empty and the hash is of the address alone.
IP_HASH_SALT=

# Optional: enables GET /api/admin/leads (CSV) with the X-Admin-Token header.
ADMIN_TOKEN=

# Optional: a Slack/Teams/CRM webhook that receives each contact request as JSON.
CONTACT_WEBHOOK_URL=

# Optional: lifts GitHub's anonymous rate limit for the changelog.
GITHUB_TOKEN=

# Contact-form rate limit: requests per window, and the window in minutes.
CONTACT_PERMIT_LIMIT=5
CONTACT_WINDOW_MINUTES=10

# Image tag to build or pull.
IMAGE_TAG=local
