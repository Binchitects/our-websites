# The edge for both sites. Caddy obtains and renews one certificate per name and
# forwards each host to its own web image; the images set the security headers,
# and the Argus image proxies /api.
#
# The domains come from SITE_DOMAIN and BINCHIECTS_DOMAIN
# (docker-compose.prod.yml); the defaults are the addresses the sites were built
# for.

{$SITE_DOMAIN:argus.binchitects.com} {
	encode zstd gzip
	reverse_proxy web:8080

	log {
		output stdout
		format json
	}
}

{$BINCHIECTS_DOMAIN:binchitects.com} {
	encode zstd gzip
	reverse_proxy binchitects:8080

	log {
		output stdout
		format json
	}
}

www.{$BINCHIECTS_DOMAIN:binchitects.com} {
	redir https://{$BINCHIECTS_DOMAIN:binchitects.com}{uri} permanent
}
